# Discord Bot Token (Lấy từ https://discord.com/developers/applications)
DISCORD_TOKEN=your_discord_bot_token_here

# Cấu hình AI API (GPT / OpenAI compatible API)
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Danh sách username hoặc User ID Discord được phép dùng AI (ngăn cách bằng dấu phẩy)
ALLOWED_AI_USERS=user1,user2

# Cấu hình Trình duyệt Gemini (msedge: Microsoft Edge mặc định mượt mà trên Windows)
BROWSER_CHANNEL=msedge
CFT_EXECUTABLE_PATH=
CFT_PROFILE_DIR=gemini_profile
